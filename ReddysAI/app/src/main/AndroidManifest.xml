<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════════════════════
         PERMISSIONS
    ══════════════════════════════════════════════════════════════ -->

    <!-- Floating overlay: SYSTEM_ALERT_WINDOW (must be granted manually on MIUI) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Microphone for voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera for taking pictures upon voice command -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Network — Gmail API, Google Sign-In -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service — keeps the overlay alive on MIUI/HyperOS -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Queries for SpeechRecognizer service on Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.tts" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.as" />
    </queries>

    <!-- POST_NOTIFICATIONS — needed on API 33+ for foreground service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibrate for haptic feedback on actions -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock: keep CPU alive briefly during automation sequences -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Receive boot completed — re-start overlay after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Query all packages — allows Reddy to find and launch any installed app on Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Contacts & Phone calls -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".ReddysAIApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReddysAI"
        tools:targetApi="31">

        <!-- ── MAIN ACTIVITY (launcher + permission setup) ──────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ReddysAI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── PAYMENT CONFIRMATION DIALOG ACTIVITY ─────────────────── -->
        <!-- Full-screen opaque overlay, no animation — shown immediately when
             payment keywords are detected during automation. This MUST be a
             separate Activity so it can appear over any other app. -->
        <activity
            android:name=".safety.PaymentConfirmationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ReddysAI.PaymentAlert"
            android:showOnLockScreen="false"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- ── OVERLAY FOREGROUND SERVICE ───────────────────────────── -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone"
            android:permission="android.permission.FOREGROUND_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay" />
        </service>

        <!-- ── ACCESSIBILITY SERVICE ────────────────────────────────── -->
        <service
            android:name=".service.ReddyAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── BOOT RECEIVER ─────────────────────────────────────────── -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- MIUI specific -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
